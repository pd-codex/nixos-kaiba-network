[Unit]
Description=Kaiba approval-gated development YubiKey signer
Documentation=file:/usr/local/share/doc/kaiba-ubuntu-signing-gate/README.md
Wants=pcscd.service polkit.service
After=pcscd.service polkit.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=kaiba-signing
Group=kaiba-signing
ExecStart=@PACKAGE_PATH@/bin/kaiba-provision-signing-gate
LoadCredential=yubikey-pin:/run/kaiba-provision-signing-credentials/yubikey-pin

StateDirectory=kaiba-provision-signing
StateDirectoryMode=0700
RuntimeDirectory=kaiba-provision-signing
RuntimeDirectoryMode=0700
UMask=0077
LimitCORE=0

Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

AmbientCapabilities=
CapabilityBoundingSet=
DevicePolicy=closed
IPAddressDeny=any
InaccessiblePaths=-/run/kaiba-provision-signing-credentials
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
StandardInput=null
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
